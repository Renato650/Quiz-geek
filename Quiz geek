<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<!-- Configurações essenciais para o Google -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz de Filmes e Séries | Quiz Geek</title>
<meta name="description" content="Teste seus conhecimentos sobre filmes, séries e cultura pop! 20 perguntas divertidas e fáceis de jogar.">
<meta name="keywords" content="quiz, filmes, séries, cultura pop, entretenimento">
<meta name="author" content="Renato650">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:linear-gradient(135deg,#0f172a,#1e293b,#111827);
color:white;
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
padding:20px 0;
}

.container{
width:90%;
max-width:700px;
background:#1e293b;
padding:30px;
border-radius:20px;
box-shadow:0 0 30px cyan;
animation:fade .6s;
}

@keyframes fade{
from{
opacity:0;
transform:scale(.9);
}
to{
opacity:1;
transform:scale(1);
}
}

h1{
text-align:center;
margin-bottom:20px;
color:#00e5ff;
font-size:2rem;
}

#pergunta{
font-size:22px;
margin-bottom:20px;
line-height:1.5;
}

button{
width:100%;
padding:15px;
margin:10px 0;
border:none;
border-radius:12px;
font-size:18px;
cursor:pointer;
background:#334155;
color:white;
transition:.3s;
}

button:hover{
background:#00bcd4;
transform:scale(1.03);
}

#progresso{
margin-top:15px;
text-align:center;
color:#bbb;
font-size:16px;
}

#resultado{
text-align:center;
font-size:28px;
display:none;
line-height:1.6;
}

.botao-reiniciar{
margin-top:30px;
background:#00bcd4;
font-weight:bold;
}
.botao-reiniciar:hover{
background:#00e5ff;
}
</style>

</head>
<body>

<div class="container">

<h1>🎬 Quiz de Filmes e Séries</h1>

<div id="quiz">

<h2 id="pergunta"></h2>

<div id="respostas"></div>

<p id="progresso"></p>

</div>

<div id="resultado"></div>

</div>

<script>

const perguntas=[
{pergunta:"Em 'The Boys', qual é o nome do líder dos Sete?",opcoes:["Capitão Pátria","Soldier Boy","A-Train"],correta:0},
{pergunta:"Quem interpreta o Deadpool?",opcoes:["Ryan Reynolds","Chris Pratt","Tom Holland"],correta:0},
{pergunta:"Qual é o nome do planeta principal de Avatar?",opcoes:["Pandora","Krypton","Arrakis"],correta:0},
{pergunta:"Em Stranger Things, quem desaparece na primeira temporada?",opcoes:["Will Byers","Mike Wheeler","Steve Harrington"],correta:0},
{pergunta:"Qual filme ganhou o Oscar de Melhor Filme em 2024?",opcoes:["Oppenheimer","Barbie","Missão Impossível"],correta:0},
{pergunta:"Quem usa o martelo Mjölnir?",opcoes:["Thor","Loki","Hulk"],correta:0},
{pergunta:"Qual é o nome do robô em WALL-E?",opcoes:["WALL-E","Bender","R2-D2"],correta:0},
{pergunta:"Em Jurassic World, quais animais são recriados?",opcoes:["Dinossauros","Dragões","Mamutes"],correta:0},
{pergunta:"Quem é o assassino mascarado em Pânico?",opcoes:["Ghostface","Jason","Leatherface"],correta:0},
{pergunta:"Em Supernatural, quem é irmão de Sam?",opcoes:["Dean","Castiel","Crowley"],correta:0},
{pergunta:"Qual é a profissão de John Wick?",opcoes:["Assassino","Policial","Médico"],correta:0},
{pergunta:"Em Round 6, qual é o prêmio final?",opcoes:["45,6 bilhões de won","1 milhão de dólares","100 milhões de ienes"],correta:0},
{pergunta:"Quem é o vilão principal em Vingadores: Guerra Infinita?",opcoes:["Thanos","Ultron","Loki"],correta:0},
{pergunta:"Qual série mostra Joel e Ellie?",opcoes:["The Last of Us","Dark","Lost"],correta:0},
{pergunta:"Em Harry Potter, quem é o diretor de Hogwarts?",opcoes:["Alvo Dumbledore","Snape","Hagrid"],correta:0},
{pergunta:"Qual filme mostra Maverick como piloto?",opcoes:["Top Gun","Velozes e Furiosos","Transformers"],correta:0},
{pergunta:"Quem interpreta Wednesday Addams na série da Netflix?",opcoes:["Jenna Ortega","Emma Myers","Millie Bobby Brown"],correta:0},
{pergunta:"Qual filme de terror apresenta a boneca Annabelle?",opcoes:["Invocação do Mal","Halloween","It"],correta:0},
{pergunta:"Qual é o nome do personagem de Keanu Reeves em Matrix?",opcoes:["Neo","Morpheus","Smith"],correta:0},
{pergunta:"Em Guardiões da Galáxia, qual animal é Rocket?",opcoes:["Guaxinim","Raposa","Lobo"],correta:0}
];

let indice=0;
let pontos=0;

function carregar(){
let p=perguntas[indice];
document.getElementById("pergunta").innerHTML=p.pergunta;
document.getElementById("progresso").innerHTML="Pergunta "+(indice+1)+" de "+perguntas.length;
let area=document.getElementById("respostas");
area.innerHTML="";

p.opcoes.forEach((opcao,i)=>{
let botao=document.createElement("button");
botao.innerHTML=opcao;
botao.onclick=()=>{
if(i==p.correta) pontos++;
indice++;
if(indice<perguntas.length){
carregar();
}else{
fim();
}
};
area.appendChild(botao);
});
}

function fim(){
document.getElementById("quiz").style.display="none";
let r=document.getElementById("resultado");
r.style.display="block";
r.innerHTML=`🏆 Você acertou <br><br><b>${pontos}</b> de ${perguntas.length} perguntas!
<br><br>
<button class="botao-reiniciar" onclick="reiniciar()">Jogar Novamente</button>`;
}

function reiniciar(){
indice=0;
pontos=0;
document.getElementById("quiz").style.display="block";
document.getElementById("resultado").style.display="none";
carregar();
}

carregar();
</script>

</body>
</html>
